# Upload-keystore credentials for signing the AAB you publish to Google Play.
#
# Copy this file to `keystore.properties` (which is gitignored) and fill in the
# values. The release build reads them to sign the bundle; without the file the
# release build falls back to debug signing — fine for local testing, but Play
# rejects debug-signed uploads.
#
# Generate an upload keystore once (keep the .jks and these passwords safe and
# backed up — losing them means you can't ship updates under the same upload
# key without resetting it via Play support):
#
#   keytool -genkeypair -v -keystore upload-keystore.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# storeFile is resolved relative to the repo root. The .jks itself is gitignored
# (*.jks / *.keystore) — do NOT commit it.

storeFile=upload-keystore.jks
storePassword=
keyAlias=upload
keyPassword=
