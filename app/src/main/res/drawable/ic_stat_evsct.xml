<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar (notification small) icon: the logo's lightning bolt on its
     own. Android draws small icons from the alpha channel alone, so it
     must be one flat colour on transparency; the full-colour launcher icon
     showed as a plain white shape. The bolt is drawn solid rather than cut
     out of the logo's circle badge: the lock screen and always-on display
     draw these icons so small that a cut-out bolt closed up into a plain
     dot. The path is the bolt from ic_launcher_monochrome.xml, scaled to
     fill 2-22 of the 24dp canvas (the standard 2dp padding) and centred. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <group
      android:scaleX="0.208333"
      android:scaleY="0.208333"
      android:translateX="-41.3333"
      android:translateY="-40.0833">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M266,202 L222,262 L250,262 L240,298 L290,242 L262,242 Z" />
  </group>
</vector>
