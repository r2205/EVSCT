<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar (notification small) icon: the logo's bolt badge, a solid
     circle with the bolt punched out. Android draws small icons from the
     alpha channel alone, so it must be one flat colour on transparency;
     the full-colour adaptive launcher icon, with its opaque background
     layer, showed as a plain white shape. The path is the badge from
     ic_launcher_monochrome.xml, scaled so its circle fills 2-22 of the
     24dp canvas (the standard 2dp padding). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
  <group
      android:scaleX="0.181818"
      android:scaleY="0.181818"
      android:translateX="-34.545"
      android:translateY="-33.4545">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M201,250 A55,55 0 1 0 311,250 A55,55 0 1 0 201,250 Z M266,202 L222,262 L250,262 L240,298 L290,242 L262,242 Z" />
  </group>
</vector>
